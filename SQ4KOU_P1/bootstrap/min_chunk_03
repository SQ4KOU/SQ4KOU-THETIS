  Clk Auto
} [get_bd_intf_pins wb_0/S_AXI]

set_property RANGE 64K [get_bd_addr_segs ps_0/Data/SEG_wb_0_reg0]
set_property OFFSET 0x48000000 [get_bd_addr_segs ps_0/Data/SEG_wb_0_reg0]
"""
    text = replace_once(text, address_anchor, address_append, "adres WB")

    for invariant in (
        "set_property OFFSET 0x40000000 [get_bd_addr_segs ps_0/Data/SEG_sts_0_reg0]",
        "set_property OFFSET 0x40001000 [get_bd_addr_segs ps_0/Data/SEG_cfg_0_reg0]",
        "set_property OFFSET 0x40002000 [get_bd_addr_segs ps_0/Data/SEG_writer_0_reg0]",
        "set_property OFFSET 0x40010000 [get_bd_addr_segs ps_0/Data/SEG_reader_0_reg0]",
        "set_property OFFSET 0x4000C000 [get_bd_addr_segs ps_0/Data/SEG_writer_0_reg01]",
        "set_property OFFSET 0x40003000 [get_bd_addr_segs ps_0/Data/SEG_switch_0_Reg]",
        "set_property OFFSET 0x40004000 [get_bd_addr_segs ps_0/Data/SEG_writer_1_reg0]",
        "set_property OFFSET 0x40005000 [get_bd_addr_segs ps_0/Data/SEG_writer_1_reg01]",
        "set_property OFFSET 0x40006000 [get_bd_addr_segs ps_0/Data/SEG_writer_0_reg02]",
        "set_property OFFSET 0x40007000 [get_bd_addr_segs ps_0/Data/SEG_reader_0_reg01]",
        "set_property OFFSET 0x40020000 [get_bd_addr_segs ps_0/Data/SEG_xadc_0_Reg]",
    ):
        if text.count(invariant) != 1:
            fail("Naruszono oryginalna mape FPGA: " + invariant)
    if text.count("wb_0/S_AXI") != 1 or text.count("0x48000000") != 1:
        fail("Kontrakt nowego adresu WB nie jest jednoznaczny.")
    if text.count("adc_tdata adc_0/m_axis_tdata") != 1:
        fail("WB nie jest pojedynczym pasywnym tapem raw ADC.")
    # Match the complete property line.  The old V1 check searched for the
    # substring "DIN_FROM 3", which also matched existing lines such as
    # "DIN_FROM 31" and falsely rejected the correct 20190527 source.
    if text.count("dout wb_0/pps") != 1 or text.count("  DIN_FROM 3\n") != 1:
        fail("GPS PPS nie jest jednoznacznym pasywnym tapem E1 DIO3_N.")

    block.write_text(text, encoding="utf-8", newline="\n")
    patch_dsp48_projects(repo)
    patch_constant_cells(repo)
    patch_project_driver(repo)
    patch_axi_address_mapping(repo)
    log("PATCH FPGA PASS: baza 20190527 + IN2/WB + GPS PPS DIO3_N + DSP48/constant")


