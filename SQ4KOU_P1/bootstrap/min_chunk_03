ewline="\n")
        tx.write_text(tx_text, encoding="utf-8", newline="\n")
    elif not (sha256(rx) == PATCHED_RX_SHA and sha256(tx) == PATCHED_TX_SHA):
        fail("RX/TX nie sa ani czysta baza 20190527, ani dokladnym backportem DSP48.")

    combined = rx.read_text(encoding="utf-8") + tx.read_text(encoding="utf-8")
    if "xbip_dsp48_macro" in combined or "RNDSIMPLE(A*B+CARRYIN)" in combined:
        fail("Backport DSP48 pozostawil odwolanie do wycofanego IP.")
    if combined.count("pavel-demin:user:dsp48") != 3:
        fail("Backport DSP48 ma nieoczekiwana liczbe deklaracji RX/TX.")


