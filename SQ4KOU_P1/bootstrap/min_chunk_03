    cores_text = ensure_core_list_entry(cores_text, "constant_v1_0")
    cores.write_text(cores_text, encoding="utf-8", newline="\n")

    text = block.read_text(encoding="utf-8")
    if "wb_0" in text or "0x48000000" in text:
        fail("Baza FPGA nie jest czysta: znaleziono istniejacy WB.")

    wb_cell = """# WIDEBAND - passive raw physical IN2 / ADC-B snapshot

