cell pavel-demin:user:port_slicer gps_pps_slice_0 {
  DIN_WIDTH 4
  DIN_FROM 3
  DIN_TO 3
} {
  din gpio_0/deb_data
  dout wb_0/pps
}
"""
    text = replace_once(text, gps_gpio_anchor, gps_gpio_append, "GPS PPS tap DIO3_N")

    address_anchor = """set_property RANGE 64K [get_bd_addr_segs ps_0/Data/SEG_xadc_0_Reg]
set_property OFFSET 0x40020000 [get_bd_addr_segs ps_0/Data/SEG_xadc_0_Reg]
"""
    address_append = address_anchor + """

# WIDEBAND - isolated 64 KiB AXI window, outside every original 0x400xxxxx map
apply_bd_automation -rule xilinx.com:bd_rule:axi4 -config {
