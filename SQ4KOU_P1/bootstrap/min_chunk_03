  aresetn rst_0/peripheral_aresetn
  adc_clk pll_0/clk_out1
  adc_tvalid adc_0/m_axis_tvalid
  adc_tdata adc_0/m_axis_tdata
}

"""
    text = replace_once(text, "# DAC\n", wb_cell + "# DAC\n", "komorka WB")

    # GPS PPS: passive tap of the already existing debounced E1 DIO3_N input.
    # The original HPSDR GPIO path remains connected exactly as before.
    gps_gpio_anchor = """cell pavel-demin:user:gpio_debouncer gpio_0 {
