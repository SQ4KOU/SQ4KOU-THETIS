def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def fail(message: str) -> None:
    raise RuntimeError(message)


def replace_once(text: str, old: str, new: str, label: str) -> str:
    count = text.count(old)
    if count != 1:
        fail(f"{label}: oczekiwano jednego kotwiczenia, znaleziono {count}")
    return text.replace(old, new, 1)


def ensure_core_list_entry(text: str, core_name: str) -> str:
    if core_name in text.split():
        return text
    anchor = " \\\n]"
    if text.count(anchor) != 1:
        fail(f"Lista IP: nie znaleziono jednoznacznego konca dla {core_name}")
    return text.replace(anchor, f" {core_name} \\\n]", 1)


