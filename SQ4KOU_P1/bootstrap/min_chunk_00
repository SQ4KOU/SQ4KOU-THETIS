def patch_constant_cells(repo: Path) -> None:
    block = repo / "projects" / PROJECT / "block_design.tcl"
    rx = repo / "projects" / PROJECT / "rx.tcl"

    block_text = block.read_text(encoding="utf-8")
    if "cell xilinx.com:ip:xlconstant const_0" in block_text:
        block_text = replace_once(
            block_text,
            "cell xilinx.com:ip:xlconstant const_0",
            "cell pavel-demin:user:constant const_0",
            "Block Design oficjalny zamiennik xlconstant",
        )
        block.write_text(block_text, encoding="utf-8", newline="\n")

    rx_text = rx.read_text(encoding="utf-8")
    if "cell xilinx.com:ip:xlconstant const_0" in rx_text:
        rx_text = replace_once(
            rx_text,
            "cell xilinx.com:ip:xlconstant const_0",
            "cell pavel-demin:user:constant const_0",
            "RX oficjalny zamiennik xlconstant",
        )
        rx.write_text(rx_text, encoding="utf-8", newline="\n")

    if "xilinx.com:ip:xlconstant" in block.read_text(encoding="utf-8"):
        fail("Block Design nadal odwoluje sie do wycofywanego xlconstant.")
    if "xilinx.com:ip:xlconstant" in rx.read_text(encoding="utf-8"):
        fail("RX nadal odwoluje sie do wycofywanego xlconstant.")


