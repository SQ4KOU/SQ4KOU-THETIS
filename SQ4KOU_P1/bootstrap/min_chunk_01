def validate_object_address_map_source(block: Path) -> None:
    text = block.read_text(encoding="utf-8")
    required = (
        'proc bd_num {value} {',
        'proc connect_gp0_auto {interface_path range offset} {',
        'set before_paths {}',
        'apply_bd_automation -rule xilinx.com:bd_rule:axi4 -config {',
        'set after [get_bd_addr_segs -quiet -of_objects $address_space]',
        'if {[lsearch -exact $before_paths $segment_path] < 0} {',
        'set relation [get_bd_addr_segs -quiet -addressing -of_objects [lindex $slave 0]]',
        'set_property RANGE $range $mapped_segment',
        'set_property OFFSET $offset $mapped_segment',
        'connect_gp0_auto wb_0/S_AXI                64K 0x48000000',
    )
    for item in required:
        if text.count(item) != 1:
            fail("Kontrakt mapy AXI nie jest jednoznaczny: " + item)
    if re.search(r'^\s*assign_bd_address\b', text, re.MULTILINE):
        fail("Mapa AXI V1.8 nie moze wykonywac assign_bd_address.")
    if 'SEG_SQ4KOU_' in text:
        fail("Mapa AXI V1.8 nie moze zalezec od nazw SEG_SQ4KOU_*.")
    calls = [line for line in text.splitlines() if line.startswith("connect_gp0_auto ")]
    expected_calls = [
        "connect_gp0_auto sts_0/S_AXI               4K  0x40000000",
        "connect_gp0_auto cfg_0/S_AXI               4K  0x40001000",
        "connect_gp0_auto writer_0/S_AXI            4K  0x40002000",
        "connect_gp0_auto rx_0/reader_0/S_AXI       32K 0x40010000",
        "connect_gp0_auto tx_0/writer_0/S_AXI       16K 0x4000C000",
        "connect_gp0_auto tx_0/switch_0/S_AXI_CTRL  4K  0x40003000",
        "connect_gp0_auto tx_0/writer_1/S_AXI       4K  0x40004000",
        "connect_gp0_auto codec/writer_1/S_AXI      4K  0x40005000",
        "connect_gp0_auto codec/writer_0/S_AXI      4K  0x40006000",
        "connect_gp0_auto codec/reader_0/S_AXI      4K  0x40007000",
        "connect_gp0_auto xadc_0/s_axi_lite         64K 0x40020000",
        "connect_gp0_auto wb_0/S_AXI                64K 0x48000000",
    ]
    if calls != expected_calls:
        fail("Mapa AXI nie zawiera dokladnie zatwierdzonych 12 polaczen w kolejnosci bazy 20190527.")
    if not text.endswith(expected_calls[-1] + "\n"):
        fail("Po mapie AXI znajduja sie nieoczekiwane instrukcje.")
    section_marker = "# AXI4 GP0 connections: preserve 20190527 order; capture each newly created segment.\n"
    if text.count(section_marker) != 1:
        fail("Sekcja mapy AXI nie ma jednoznacznego poczatku.")
    section = text[text.index(section_marker):]
    if hashlib.sha256(section.encode("utf-8")).hexdigest() != ADDRESS_SECTION_SHA:
        fail("Sekcja mapy AXI nie jest bajtowo zgodna z zatwierdzonym V1.8.")


