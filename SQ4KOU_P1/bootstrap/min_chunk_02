alized [string map {_ ""} $value]
  switch -nocase -- $normalized {
    4K  { return 4096 }
    16K { return 16384 }
    32K { return 32768 }
    64K { return 65536 }
  }
  if {[scan $normalized %i parsed] == 1} { return $parsed }
  error "Cannot normalize AXI value: $value"
}

proc connect_gp0_auto {interface_path range offset} {
  set interface [get_bd_intf_pins -quiet $interface_path]
  if {[llength $interface] != 1} {
    error "AXI interface count is not one: $interface_path"
  }
  set address_space [get_bd_addr_spaces -quiet ps_0/Data]
  if {[llength $address_space] != 1} {
    error "PS GP0 address space count is not one"
  }

  # Snapshot the master address space before automation. This is independent
  # of generated segment names and assign_bd_address return semantics.
  set before_paths {}
  foreach segment [get_bd_addr_segs -quiet -of_objects $address_space] {
    lappend before_paths [get_property PATH $segment]
  }

  apply_bd_automation -rule xilinx.com:bd_rule:axi4 -config {
    Master /ps_0/M_AXI_GP0
    Clk Auto
  } $interface

  set after [get_bd_addr_segs -quiet -of_objects $address_space]
  set mapped {}
  foreach segment $after {
    set segment_path [get_property PATH $segment]
    if {[lsearch -exact $before_paths $segment_path] < 0} {
      lappend mapped $segment
    }
  }

  # Defensive fallback using the documented slave->master addressing relation.
  if {[llength $mapped] != 1} {
    set slave [get_bd_addr_segs -quiet -addressables -of_objects $interface]
    if {[llength $slave] != 1} {
      set slave [get_bd_addr_segs -quiet -of_objects $interface]
    }
    if {[llength $slave] == 1} {
      set relation [get_bd_addr_segs -quiet -addressing -of_objects [lindex $slave 0]]
      set mapped {}
      foreach segment $relation {
        if {[lsearch -exact $after $segment] >= 0} {
          lappend mapped $segment
        }
      }
    }
  }

  if {[llength $mapped] != 1} {
    error "Cannot identify exactly one new GP0 segment: $interface_path"
  }
  set mapped_segment [lindex $mapped 0]

  # Same operation as original 20190527, but on the actual Vivado object.
  set_property RANGE $range $mapped_segment
  set_property OFFSET $offset $mapped_segment

  set actual_offset [get_property OFFSET $mapped_segment]
  set actual_range  [get_property RANGE  $mapped_segment]
  if {[bd_num $actual_offset] != [bd_num $offset]} {
    error "AXI OFFSET mismatch: $interface_path expected=$offset actual=$actual_offset"
  }
  if {[bd_num $actual_range] != [bd_num $range]} {
    error "AXI RANGE mismatch: $interface_path expected=$range actual=$actual_range"
  }
}

